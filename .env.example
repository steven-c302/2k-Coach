# Copy to .env and fill in. docker-compose reads these from the shell/`.env`
# automatically; core also falls back to a local JSON seed if
# NBA2KAPI_API_KEY is left blank (see JsonSeedLoader).

NBA2KAPI_API_KEY=
NBA2KAPI_TEAM_TYPE=curr

# Coaching narration (Milestone 6). Leave blank to use the free local
# TemplateNarrationClient fallback — no cost, no external calls.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
