# Copy to .env and fill in. docker-compose reads these from the shell/`.env`
# automatically; core also falls back to a local JSON seed if
# NBA2KAPI_API_KEY is left blank (see JsonSeedLoader).

NBA2KAPI_API_KEY=

# Coaching narration. Leave blank to use the free local TemplateNarrationClient
# fallback — no cost, no external calls. claude-haiku-4-5 is the cheapest current
# model and plenty for this (a couple of sentences of coaching narration) - a
# real matchup analysis call costs roughly $0.002-0.004.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
